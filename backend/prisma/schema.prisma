generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum Role { LEARNER COMPANY HR ADMIN }
enum CourseStatus { DRAFT PUBLISHED UNPUBLISHED ARCHIVED }
model User { id String @id @default(cuid()) email String @unique name String passwordHash String role Role active Boolean @default(true) companyId String? createdAt DateTime @default(now()) company Company? @relation(fields: [companyId], references: [id]) enrollments Enrollment[] certificates Certificate[] auditLogs AuditLog[] }
model Company { id String @id @default(cuid()) name String description String? website String? users User[] courses Course[] createdAt DateTime @default(now()) }
model Course { id String @id @default(cuid()) title String description String @db.Text detailedDescription String? @db.Text thumbnail String? category String difficulty String duration String? instructorName String? instructorBio String? prerequisites String? learningObjectives Json? targetAudience String? status CourseStatus @default(DRAFT) companyId String company Company @relation(fields: [companyId], references: [id]) modules CourseModule[] enrollments Enrollment[] assessments Assessment[] skills CourseSkill[] createdAt DateTime @default(now()) @@index([companyId, status]) }
model CourseModule { id String @id @default(cuid()) title String description String? @db.Text duration String? learningObjectives Json? courseId String course Course @relation(fields: [courseId], references: [id], onDelete: Cascade) lessons Lesson[] assessments Assessment[] }
model Lesson { id String @id @default(cuid()) title String description String? @db.Text content String @db.Text type String duration String? videoUrl String? resourceUrl String? moduleId String module CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade) }
model Enrollment { id String @id @default(cuid()) userId String courseId String progress Int @default(0) status String completedAt DateTime? user User @relation(fields: [userId], references: [id], onDelete: Cascade) course Course @relation(fields: [courseId], references: [id], onDelete: Cascade) @@unique([userId, courseId]) }
model Assessment { id String @id @default(cuid()) title String description String? @db.Text courseId String course Course @relation(fields: [courseId], references: [id], onDelete: Cascade) moduleId String? module CourseModule? @relation(fields: [moduleId], references: [id]) passingScore Int maxAttempts Int timeLimit Int? randomizeQuestions Boolean @default(false) showAnswersAfterSubmission Boolean @default(false) questions AssessmentQuestion[] attempts AssessmentAttempt[] }
model AssessmentQuestion { id String @id @default(cuid()) text String @db.Text type String marks Int @default(1) assessmentId String assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade) options AssessmentOption[] }
model AssessmentOption { id String @id @default(cuid()) text String correct Boolean questionId String question AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade) }
model AssessmentAttempt { id String @id @default(cuid()) score Int passed Boolean userId String assessmentId String submittedAt DateTime @default(now()) }
model Skill { id String @id @default(cuid()) name String @unique courses CourseSkill[] certificates CertificateSkill[] }
model CourseSkill { courseId String skillId String course Course @relation(fields: [courseId], references: [id], onDelete: Cascade) skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade) @@id([courseId, skillId]) }
model CertificationTrack { id String @id @default(cuid()) title String rules CertificationRule[] skills CertificationSkill[] certificates Certificate[] }
model CertificationRule { id String @id @default(cuid()) type String value String trackId String track CertificationTrack @relation(fields: [trackId], references: [id], onDelete: Cascade) }
model CertificationSkill { trackId String skillId String track CertificationTrack @relation(fields: [trackId], references: [id], onDelete: Cascade) skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade) @@id([trackId, skillId]) }
model Certificate { id String @id @default(cuid()) certificateId String @unique certificateNumber String @unique learnerName String courseName String certification String issuedBy String score Int completionDate DateTime issuedDate DateTime expiryDate DateTime? verificationUrl String pdfUrl String status String trackId String? learnerId String courseId String skills CertificateSkill[] verifications CertificateVerification[] revocations CertificateRevocation[] track CertificationTrack? }
model CertificateSkill { certificateId String skillId String certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade) skill Skill @relation(fields: [skillId], references: [id]) @@id([certificateId, skillId]) }
model CertificateVerification { id String @id @default(cuid()) certificateId String requestedAt DateTime @default(now()) ip String? certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade) }
model CertificateRevocation { id String @id @default(cuid()) certificateId String reason String actorId String timestamp DateTime @default(now()) certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade) }
model AuditLog { id String @id @default(cuid()) actorId String? action String entityType String entityId String timestamp DateTime @default(now()) status String metadata Json? ip String? user User? @relation(fields: [actorId], references: [id]) }
